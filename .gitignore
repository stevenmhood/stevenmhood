# Ignore everything by default — whitelist what we want tracked.
# For subdirectories: must unignore each parent level or git won't
# traverse in, and child negations (!path) will have no effect.
*

# Top-level dotfiles
!.bashrc
!.dir_colors
!.gitconfig
!.gitignore
!.ssh-agent-rc
!.tmux.conf
!.toprc
!.vimrc
!_vimrc

# .claude — whitelist specific paths
!.claude/
.claude/*
!.claude/docs/
!.claude/docs/*
.claude/docs/plans/
!.claude/hooks/
!.claude/hooks/**
.claude/**/*.log
!.claude/settings.json
!.claude/statusline-command.sh

# Generated agent-hook state
.local/state/agent-hooks/**/*.log

# .codex — track only the durable personal hook registrations. Codex runtime
# config, trust state, sessions, auth, plugins, and caches remain ignored.
!.codex/
.codex/*
!.codex/hooks.json

# .config — starship + tmux drop-in fragments
!.config/
.config/*
!.config/agent-hooks/
!.config/agent-hooks/**
!.config/git/
.config/git/*
!.config/git/config
!.config/git/ignore
!.config/starship.toml
!.config/tmux/
.config/tmux/*
!.config/tmux/conf.d/
.config/tmux/conf.d/*
!.config/tmux/conf.d/00-session-persistence.conf

# .vim — only colors
!.vim/
.vim/*
!.vim/colors/
!.vim/colors/**

# .zshrc.d — shell plugins
!.zshrc.d/
.zshrc.d/*
!.zshrc.d/direnv.zsh
!.zshrc.d/mac.zsh
!.zshrc.d/node.zsh
!.zshrc.d/python.zsh
!.zshrc.d/vcs_info.zsh
!.zshrc.d/wsl.zsh
!.zshrc.d/znap.zsh

# scripts
!scripts/
scripts/*
!scripts/claude-bedrock
!scripts/config-pref.js
!scripts/config-steven.js
!scripts/count-tokens
!scripts/findup
!scripts/yesno

# Swap files (redundant with * but explicit)
*.swp
*.zwc
