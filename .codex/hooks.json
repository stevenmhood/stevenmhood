{
  "description": "Personal lifecycle hooks shared across agent harnesses.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.config/agent-hooks/tmux-window-name.sh",
            "statusMessage": "Updating tmux window name"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "~/.config/agent-hooks/gh-api-readonly.sh",
            "timeout": 5,
            "statusMessage": "Checking GitHub API safety"
          },
          {
            "type": "command",
            "command": "~/.config/agent-hooks/git-safety.sh",
            "timeout": 5,
            "statusMessage": "Checking git safety"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "~/.config/agent-hooks/tmux-window-name.sh",
            "timeout": 5,
            "statusMessage": "Updating tmux window name"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.config/agent-hooks/attention-on.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.config/agent-hooks/attention-on.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.config/agent-hooks/demeanor-reminder.sh",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "~/.config/agent-hooks/attention-off.sh",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
